PORT=4000
NODE_ENV=development

ACCESS_SECRET=change-me
REFRESH_SECRET=change-me
ACCESS_EXPIRES_IN=3600
REFRESH_EXPIRES_IN=604800

CORS_ORIGINS=http://localhost:3000

REGIONS=eg,sa

DB_POOL_MAX=10
DB_MIGRATION_DIRECTORY=src/migrations
DB_MIGRATION_EXTENSION=ts

DB_eg_HOST=localhost
DB_eg_PORT=5432
DB_eg_USERNAME=postgres
DB_eg_PASSWORD=
DB_eg_NAME=order_service_eg

DB_sa_HOST=localhost
DB_sa_PORT=5432
DB_sa_USERNAME=postgres
DB_sa_PASSWORD=
DB_sa_NAME=order_service_sa

ARCHIVE_DB_eg_HOST=localhost
ARCHIVE_DB_eg_PORT=5432
ARCHIVE_DB_eg_USERNAME=postgres
ARCHIVE_DB_eg_PASSWORD=
ARCHIVE_DB_eg_NAME=order_service_archive_eg

ARCHIVE_DB_sa_HOST=localhost
ARCHIVE_DB_sa_PORT=5432
ARCHIVE_DB_sa_USERNAME=postgres
ARCHIVE_DB_sa_PASSWORD=
ARCHIVE_DB_sa_NAME=order_service_archive_sa

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_CORE_EVENTS_EXCHANGE=core.events
RABBITMQ_CORE_EVENTS_QUEUE=order-service.core-events
RABBITMQ_CORE_EVENTS_BINDINGS="product.#,branch.#,restaurant.#,rbac.#"
RABBITMQ_CORE_EVENTS_DLX=core.events.dlx
RABBITMQ_CORE_EVENTS_DLQ=order-service.core-events.dlq
RABBITMQ_PREFETCH=32

CORE_SERVICE_BASE_URL=http://localhost:3000
CORE_INTERNAL_API_KEY=change-me

WS_HEARTBEAT_SEC=30

# Kashier v3 — signature on webhooks is HMAC-SHA256 over `data` using KASHIER_API_KEY
# (the Payment API key), not a separate webhook secret.
KASHIER_BASE_URL=https://test-api.kashier.io
KASHIER_MERCHANT_ID=
KASHIER_API_KEY=
KASHIER_SECRET_KEY=
KASHIER_RETURN_URL=https://app.quickbite.io/checkout/return
# Optional — set this to a publicly reachable URL to have Kashier POST events here
# per-session; otherwise rely on a webhook registered in the Kashier dashboard instead.
KASHIER_WEBHOOK_URL=https://api.quickbite.io/api/v1/payments/webhook/kashier
KASHIER_SESSION_TIMEOUT_MIN=15
# Comma-separated region:providerName pairs — Kashier only settles in Egypt today.
PAYMENT_PROVIDERS_BY_REGION=eg:kashier

# A pending_payment order whose online payment never completed is auto-cancelled
# (and its reserved stock released) by a background sweep after this many minutes.
ORDER_PENDING_PAYMENT_TIMEOUT_MIN=15
ORDER_SWEEP_INTERVAL_SEC=60

# A succeeded charge whose order is still stuck in pending_payment (post-charge
# transition failed or never ran) has that transition retried by a background
# reconciler, once it's at least GRACE_SEC old (to avoid racing the webhook's own
# synchronous retry of the same transition).
PAYMENT_RECONCILER_GRACE_SEC=120
PAYMENT_RECONCILER_INTERVAL_SEC=60

# Phase 3 — agents/delivery broadcast assignment & presence (agents.md §1, §3)
ASSIGNMENT_RADIUS_METERS=5000
ASSIGNMENT_CANDIDATE_POOL=20
ASSIGNMENT_BROADCAST_SIZE=5
ASSIGNMENT_SWEEP_CRON_SEC=15
AGENT_ACCEPT_TIMEOUT_SEC=30
LOAD_PENALTY_METERS=1500
MAX_REASSIGNMENT_ATTEMPTS=3
AGENT_MAX_CONCURRENT_ORDERS=3
PRESENCE_STALE_SEC=300
AGENT_EARNINGS_SHARE_PCT=80
