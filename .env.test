NODE_ENV=test
PORT=4000

ACCESS_SECRET=change-me
REFRESH_SECRET=change-me
ACCESS_EXPIRES_IN=3600
REFRESH_EXPIRES_IN=604800

CORS_ORIGINS=http://localhost:3000

REGIONS=eg

DB_POOL_MAX=10
DB_MIGRATION_DIRECTORY=src/migrations
DB_MIGRATION_EXTENSION=ts

# For local (non-docker) test runs: point these at a Postgres instance already
# running on your machine with both databases created. docker-compose.test.yml
# overrides all of DB_eg_*/ARCHIVE_DB_eg_* with the compose service hostnames, so
# these values only matter outside Docker.
DB_eg_HOST=localhost
DB_eg_PORT=5432
DB_eg_USERNAME=postgres
DB_eg_PASSWORD=root
DB_eg_NAME=order_service_eg_test

ARCHIVE_DB_eg_HOST=localhost
ARCHIVE_DB_eg_PORT=5432
ARCHIVE_DB_eg_USERNAME=postgres
ARCHIVE_DB_eg_PASSWORD=root
ARCHIVE_DB_eg_NAME=order_service_archive_eg_test

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_CORE_EVENTS_EXCHANGE=core.events

CORE_SERVICE_BASE_URL=http://localhost:3000
CORE_INTERNAL_API_KEY=change-me

WS_HEARTBEAT_SEC=30

KASHIER_BASE_URL=https://test-api.kashier.io
KASHIER_MERCHANT_ID=test-merchant
KASHIER_API_KEY=test
KASHIER_SECRET_KEY=test
KASHIER_RETURN_URL=https://app.quickbite.test/checkout/return
PAYMENT_PROVIDERS_BY_REGION=eg:kashier

ORDER_PENDING_PAYMENT_TIMEOUT_MIN=15
ORDER_SWEEP_INTERVAL_SEC=60

PAYMENT_RECONCILER_GRACE_SEC=120
PAYMENT_RECONCILER_INTERVAL_SEC=60

ASSIGNMENT_RADIUS_METERS=5000
ASSIGNMENT_CANDIDATE_POOL=20
ASSIGNMENT_BROADCAST_SIZE=5
ASSIGNMENT_SWEEP_CRON_SEC=15
AGENT_ACCEPT_TIMEOUT_SEC=30
LOAD_PENALTY_METERS=1500
MAX_REASSIGNMENT_ATTEMPTS=3

AGENT_MAX_CONCURRENT_ORDERS=3
PRESENCE_STALE_SEC=300
AGENT_EARNINGS_SHARE_PCT=80

# Small on purpose — tests/integration/archival/archival.integration.test.ts relies
# on this to exercise the worker's multi-batch pagination without a huge fixture.
ARCHIVAL_BATCH_SIZE=2
ARCHIVAL_MAX_RUNTIME_MIN=60
ARCHIVAL_INTERVAL_SEC=86400
